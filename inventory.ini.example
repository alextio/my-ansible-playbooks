;; NOTE: variables defined her have the LOWEST precedence meaning that they will be clobbered if the same variable is defined in group_vars/


[local]
localhost ansible_connection=local

[REMOTE_SERVERS]
pxy         ansible_host=192.168.4.111  ansible_user=user
hp          ansible_host=100.89.217.61  ansible_user=hp
[REMOTE_SERVERS:children]
uth
proxy

[proxy]
uth_jump     ansible_host=129.106.31.39 LogLevel=ERROR

[uth]
sm           ansible_host=129.106.31.145
h100         ansible_host=129.106.31.70 LocalForward='["16686", "3000", "8080"]'
dell         ansible_host=129.106.31.89 LocalForward='["16687", "3001", "8081"]'
a100         ansible_host=129.106.31.73 LocalForward='["16688", "3002", "8082"]'
