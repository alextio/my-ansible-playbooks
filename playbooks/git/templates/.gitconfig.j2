[user]
	name = {{ git_user_name }}
	email = {{ git_user_email }}

[core]
	editor = {{ git_editor }}
	autocrlf = input
	excludesfile = ~/.gitignore_global
	hooksPath = ~/.config/git/hooks

[init]
	defaultBranch = {{ git_default_branch }}

[pull]
	rebase = {{ git_pull_rebase | lower }}

[push]
	autoSetupRemote = true

[credential]
	helper = {{ git_credential_helper }}

[credential "https://gitpapl1.uth.tmc.edu/"]
	username = oauth2

[color]
	ui = auto

[alias]
{% for alias, command in git_aliases.items() %}
	{{ alias }} = {{ command }}
{% endfor %}
