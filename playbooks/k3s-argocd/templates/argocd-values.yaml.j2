---
# Helm values for the argo-cd chart
# https://github.com/argoproj/argo-helm/blob/main/charts/argo-cd/values.yaml
#
# Bootstrap values only, applied on first install. After that, Argo CD
# manages itself from 03-argocd-kubernetes (apps/argocd/values.yaml), which
# is the source of truth. Keep the two in step for fresh clusters.

configs:
  params:
    # No ingress controller yet (traefik is disabled); serve plain HTTP so
    # the UI is reachable via `kubectl port-forward` without TLS errors
    server.insecure: true

dex:
  enabled: false
