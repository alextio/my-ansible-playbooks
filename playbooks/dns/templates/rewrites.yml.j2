# AdGuard Home DNS rewrites, fed to the role's adguardhome_rewrites by sync.yml.
# Add a name here and re-run the playbook.
#
# The role writes `domain:` unquoted into AdGuardHome.yaml, and a bare `*` is
# a YAML alias, so wildcard domains carry their own inner quotes ('"*.lan"').

# Every *.lan name goes to Traefik, which routes by Host header.
- domain: '"*.lan"'
  answer: {{ traefik_ip }}

# Let's Encrypt names (03-argocd-kubernetes/apps/traefik/
# certificate-wildcard-duckdns.yaml) also go to Traefik.
- domain: '"*.alextio.duckdns.org"'
  answer: {{ traefik_ip }}

# agentgateway terminates its own TLS, so both its names bypass Traefik.
# Exact names win over the wildcards above.
- domain: agentgateway.lan
  answer: {{ agentgateway_ip }}

- domain: agentgateway.alextio.duckdns.org
  answer: {{ agentgateway_ip }}

# Example of a name that points somewhere else:
# - domain: nas.lan
#   answer: 192.168.6.50
